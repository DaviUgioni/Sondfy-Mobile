{
  "expo": {
    "name": "Sondfy",
    "slug": "Sondfy-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sondfy",
    "icon": "./assets/sondfy-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sondfy.mobile",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#1ED760",
        "foregroundImage": "./assets/sondfy-icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "573c8f78-4971-45b3-80ec-fb1d1dbeed87"
      }
    },
    "owner": "ugioni",
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["audio/*"],
          "disableIOS": true
        }
      ]
    ]
  }
}
